# ──────────────────────────────────────────────
# Application Configuration
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# Flask
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_EXPIRE_HOURS=24

# MongoDB
MONGO_URI=mongodb://localhost:27017/electricity_analyzer
DB_NAME=electricity_analyzer

# Frontend origin (used in password-reset email link)
FRONTEND_URL=http://127.0.0.1:5000

# ──────────────────────────────────────────────
# Gmail API (OAuth 2.0)
# See docs/GMAIL_SETUP.md for setup instructions
# ──────────────────────────────────────────────

# The Gmail account that sends reset emails
GMAIL_USER=your-gmail-account@gmail.com

# From https://console.cloud.google.com/ → APIs & Services → Credentials → OAuth 2.0 Client IDs
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Redirect URI used during OAuth consent (must match Google Cloud Console)
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground

# Refresh token obtained via OAuth Playground (see GMAIL_SETUP.md)
GMAIL_REFRESH_TOKEN=

# OCR / Tesseract (optional, Windows default)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
